<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Twitties</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">

    <!-- Twitties theme -->
    <style>
      :root {
        --twittie-blue: #1d9bf0;
        --twittie-blue-dark: #1a8cd8;
        --twittie-border: #eff3f4;
        --twittie-text-muted: #536471;
      }

      body {
        background-color: #fff;
        color: #0f1419;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
      }

      .navbar {
        background-color: #fff !important;
        border-bottom: 1px solid var(--twittie-border);
      }

      .navbar-brand {
        color: var(--twittie-text-muted) !important;
        font-weight: 700;
      }

      .navbar .nav-link {
        color: #0f1419 !important;
        font-weight: 500;
      }

      .navbar .nav-link:hover {
        color: var(--twittie-blue) !important;
      }

      a {
        color: var(--twittie-blue);
      }

      .btn-primary {
        background-color: var(--twittie-blue);
        border-color: var(--twittie-blue);
      }

      .btn-primary:hover,
      .btn-primary:focus,
      .btn-primary:active {
        background-color: var(--twittie-blue-dark);
        border-color: var(--twittie-blue-dark);
      }

      .btn-outline-primary {
        color: var(--twittie-blue);
        border-color: var(--twittie-blue);
      }

      .btn-outline-primary:hover {
        background-color: var(--twittie-blue);
        border-color: var(--twittie-blue);
      }

      .rounded-pill,
      .btn {
        border-radius: 9999px;
      }

      .form-control,
      textarea.form-control {
        border-radius: 1rem;
      }

      main.container {
        max-width: 680px;
      }

      .avatar-circle {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 50%;
        background-color: var(--twittie-blue);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
      }

      .avatar-circle-sm {
        width: 36px;
        height: 36px;
        min-width: 36px;
        font-size: 0.95rem;
      }

      .twittie-row {
        border-bottom: 1px solid var(--twittie-border);
      }

      .twittie-row:hover {
        background-color: #f7f9f9;
      }

      .twittie-actions {
        color: var(--twittie-text-muted);
      }

      .twittie-actions span {
        cursor: default;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg">
      <div class="container">
        <a class="navbar-brand" href="/">🐦 Twitties</a>

        <!-- Toggle button for mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
          aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar links -->
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/posts">Twitties</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <%- body %>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
      crossorigin="anonymous"></script>
      <script>
        document.querySelectorAll('.post-date').forEach(el => {
          const iso = el.dataset.datetime;
          if (!iso) return;
          const dt = new Date(iso);
          // Format in the user's own locale/timezone
          el.textContent = dt.toLocaleString(undefined, {
            dateStyle: 'medium',
            timeStyle: 'short',
          });

        });
      </script>
  </body>
</html>