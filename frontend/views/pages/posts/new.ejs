<h1 class="mb-4">New Twittie</h1>

<form action="/posts/new" method="POST" class="needs-validation" novalidate>
  <div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input
      type="text"
      class="form-control"
      id="title"
      name="title"
      placeholder="Give it a title"
      required>
    <div class="invalid-feedback">
      Please enter a title.
    </div>
  </div>

  <div class="mb-3">
    <label for="content" class="form-label">What's happening?</label>
    <textarea
      class="form-control"
      id="content"
      name="content"
      rows="5"
      placeholder="What's happening?"
      maxlength="280"
      required></textarea>
    <div class="invalid-feedback">
      Please enter some content.
    </div>
    <div class="d-flex justify-content-end mt-1">
      <small class="text-muted"><span id="charCount">0</span>/280</small>
    </div>
  </div>

  <button type="submit" class="btn btn-primary">Twittie</button>
  <a href="/posts" class="btn btn-secondary">Cancel</a>
</form>

<script>
  const contentField = document.getElementById('content');
  const charCount = document.getElementById('charCount');
  if (contentField && charCount) {
    const updateCount = () => { charCount.textContent = contentField.value.length; };
    contentField.addEventListener('input', updateCount);
    updateCount();
  }
</script>