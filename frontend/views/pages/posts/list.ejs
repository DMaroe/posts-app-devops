<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Twitties</h1>
  <a href="/posts/new" class="btn btn-primary">New Twittie</a>
</div>

<% if (posts && posts.length > 0) { %>
  <div>
    <% posts.forEach(function(item) { %>
      <div class="twittie-row d-flex py-3">
        <div class="avatar-circle me-3">🐦</div>
        <div class="flex-grow-1">
          <a
            href="/posts/<%= item.id || item._id || item.postId %>"
            class="text-decoration-none text-reset"
          >
            <h5 class="mb-1"><%= item.title %></h5>
          </a>
          <small
            class="text-muted post-date"
            data-datetime="<%= new Date(item.created_at).toISOString() %>">
            <!-- fallback: server time -->
            <%= new Date(item.created_at).toUTCString() %>
          </small>
          <div class="twittie-actions d-flex gap-4 mt-2">
            <span>💬</span>
            <span>🔁</span>
            <span>❤️</span>
            <span>📤</span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="alert alert-info">
    No twitties yet. Click <strong>New Twittie</strong> to create one.
  </div>
<% } %>